# =============================================================================
# SLAINTE-ENGINE APPLIANCE: ENVIRONMENT CONFIGURATION
# =============================================================================

# --- Appliance Security & Bootstrap Admin Credential ---
SECRET_KEY=replace-with-a-random-32-byte-hex-string
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=ClinicalAdmin2026!

# --- Appliance Volume Paths ---
RAW_DATA_PATH=/workspace/data/raw
FHIR_STORE_PATH=/workspace/data/fhir_store
APPLIANCE_MODE=true

# =============================================================================
# CHOOSE YOUR AI PROVIDER MODE (SELECT ONE)
# =============================================================================

# -----------------------------------------------------------------------------
# MODE A: LOCAL OLLAMA (100% AIR-GAPPED, PRIVATE & ZERO EXTERNAL EGRESS)
# Recommended for on-premise NHS/HSE hospitals and strict zero-trust clinics.
# -----------------------------------------------------------------------------
LLM_PROVIDER=ollama
LLM_MODEL=ollama/qwen2.5-coder:32b
# Note: Use 'http://host.docker.internal:11434' from inside Docker containers
LLM_BASE_URL=http://host.docker.internal:11434
LLM_API_KEY=ollama

# Alternative tested local models:
# LLM_MODEL=ollama/deepseek-r1:32b
# LLM_MODEL=ollama/llama3.3:70b

# -----------------------------------------------------------------------------
# MODE B: GOOGLE GEMINI (ULTRA-FAST & HIGH CONTEXT)
# Native multimodal handwriting OCR + extraction support
# -----------------------------------------------------------------------------
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini/gemini-2.0-flash
# GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# DOC_AI_PROCESSOR_ID=your-document-ai-processor-id

# -----------------------------------------------------------------------------
# MODE C: FRONTIER CLOUD (ANTHROPIC CLAUDE & OPENAI)
# -----------------------------------------------------------------------------
# Option C1: Anthropic Claude 3.7 Sonnet
# LLM_PROVIDER=anthropic
# LLM_MODEL=anthropic/claude-3-7-sonnet-20250219
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Option C2: OpenAI GPT-4o / o3-mini
# LLM_PROVIDER=openai
# LLM_MODEL=openai/gpt-4o
# OPENAI_API_KEY=sk-proj-...
# AI_MODEL=gpt-4o
